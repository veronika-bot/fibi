DATABASE_URL="file:./dev.db"
REDIS_URL="redis://localhost:6379"
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your-master-key"
AWS_ACCESS_KEY_ID="your-key"
AWS_SECRET_ACCESS_KEY="your-secret"
AWS_REGION="eu-central-1"
AWS_S3_BUCKET="fibi-tasks"
SESSION_SECRET="change-me-to-a-long-random-string"

# Через запятую — источники, которым разрешено делать кросс-доменные запросы с cookie
# (статический сайт на GitHub Pages, tutor/-приложение на порту 3001 и т.п.)
ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:5500"

# ─── YooKassa ────────────────────────────────────────────────────────────────
# Получить в личном кабинете: https://yookassa.ru/my/shop-settings/integration
YOOKASSA_SHOP_ID="your-shop-id"
YOOKASSA_SECRET_KEY="your-secret-key"

# Комиссия платформы (0.20 = 20%)
PLATFORM_COMMISSION="0.20"

# URL для webhook YooKassa (должен быть публичным, ngrok для разработки)
# Зарегистрировать: https://yookassa.ru/my/shop-settings/http-notifications
YOOKASSA_WEBHOOK_SECRET="random-string-for-webhook-verification"

# Публичный URL приложения
NEXT_PUBLIC_APP_URL="http://localhost:3000"
